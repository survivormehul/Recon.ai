# PostgreSQL Connection (Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recon_ai?schema=public"

# AI Provider Configuration (Options: "gemini", "openai", "offline")
AI_PROVIDER="offline"

# Model Identification (Current supported Google Gemini model: "gemini-3.6-flash", OpenAI: "gpt-4o-mini")
AI_MODEL="gemini-3.6-flash"

# Provider API Keys (leave blank or specify when activating live AI investigation)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Application Settings
PORT=3000
NODE_ENV="development"
